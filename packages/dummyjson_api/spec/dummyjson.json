{
  "openapi": "3.0.3",
  "info": {
    "title": "DummyJSON API",
    "version": "0.2.1",
    "description": "Free fake REST API for placeholder JSON data.\n\nMost resources also accept an authenticated prefix: `GET /auth/{resource}` with a Bearer token\n(or `accessToken` cookie) returns the same payload as the public route while simulating a logged-in user.\n\nSingular aliases work too (`/product` \u2261 `/products`, `/user` \u2261 `/users`, etc.).\n\nHuman-readable docs: https://dummyjson.com/docs",
    "contact": {
      "name": "DummyJSON",
      "url": "https://dummyjson.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/Ovi/DummyJSON/blob/master/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://dummyjson.com",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Login, logout, refresh, and current user"
    }
  ],
  "security": [],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login and receive access/refresh tokens",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "emilys"
                  },
                  "password": {
                    "type": "string",
                    "example": "emilyspass"
                  },
                  "expiresInMins": {
                    "type": "integer",
                    "example": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh access and refresh tokens",
        "operationId": "authRefresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  },
                  "expiresInMins": {
                    "type": "integer",
                    "example": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current authenticated user",
        "operationId": "authMe",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUser"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/products": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get all products",
        "operationId": "authGetProducts",
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/skip"
          },
          {
            "$ref": "#/components/parameters/select"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/auth/products/{id}": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get a single product",
        "operationId": "authGetProductById",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/select"
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 30
        },
        "description": "Items per page. Use 0 to return all items."
      },
      "skip": {
        "name": "skip",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "description": "Number of items to skip."
      },
      "select": {
        "name": "select",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated fields to include (id is always included).",
        "example": "title,price"
      },
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Resource id."
      }
    },
    "schemas": {
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "emilys"
          },
          "email": {
            "type": "string",
            "example": "emily.johnson@x.dummyjson.com"
          },
          "firstName": {
            "type": "string",
            "example": "Emily"
          },
          "lastName": {
            "type": "string",
            "example": "Johnson"
          },
          "gender": {
            "type": "string",
            "example": "female"
          },
          "image": {
            "type": "string",
            "example": "https://dummyjson.com/icon/emilys/128"
          }
        }
      },
      "LoginResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthUser"
          },
          {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Something went wrong."
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Essence Mascara Lash Princess"
          },
          "description": {
            "type": "string",
            "example": "The Essence Mascara Lash Princess is a popular mascara known for its volumizing and lengthening effects. Achieve dramatic lashes with this long-lasting and cruelty-free formula."
          },
          "category": {
            "type": "string",
            "example": "beauty"
          },
          "price": {
            "type": "number",
            "example": 9.99
          },
          "discountPercentage": {
            "type": "number",
            "example": 10.48
          },
          "rating": {
            "type": "number",
            "example": 2.56
          },
          "stock": {
            "type": "integer",
            "example": 99
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "beauty"
            }
          },
          "brand": {
            "type": "string",
            "example": "Essence"
          },
          "sku": {
            "type": "string",
            "example": "BEA-ESS-ESS-001"
          },
          "weight": {
            "type": "integer",
            "example": 4
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "example": 15.14
              },
              "height": {
                "type": "number",
                "example": 13.08
              },
              "depth": {
                "type": "number",
                "example": 22.99
              }
            }
          },
          "warrantyInformation": {
            "type": "string",
            "example": "1 week warranty"
          },
          "shippingInformation": {
            "type": "string",
            "example": "Ships in 3-5 business days"
          },
          "availabilityStatus": {
            "type": "string",
            "example": "In Stock"
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rating": {
                  "type": "integer",
                  "example": 3
                },
                "comment": {
                  "type": "string",
                  "example": "Would not recommend!"
                },
                "date": {
                  "type": "string",
                  "example": "2025-04-30T09:41:02.053Z"
                },
                "reviewerName": {
                  "type": "string",
                  "example": "Eleanor Collins"
                },
                "reviewerEmail": {
                  "type": "string",
                  "example": "eleanor.collins@x.dummyjson.com"
                }
              }
            }
          },
          "returnPolicy": {
            "type": "string",
            "example": "No return policy"
          },
          "minimumOrderQuantity": {
            "type": "integer",
            "example": 48
          },
          "meta": {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "example": "2025-10-09T14:47:01.588Z"
              },
              "updatedAt": {
                "type": "string",
                "example": "2026-05-23T11:27:41.868Z"
              },
              "barcode": {
                "type": "string",
                "example": "5784719087687"
              },
              "qrCode": {
                "type": "string",
                "example": "https://cdn.dummyjson.com/public/qr-code.png"
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "https://cdn.dummyjson.com/product-images/beauty/essence-mascara-lash-princess/1.webp"
            }
          },
          "thumbnail": {
            "type": "string",
            "example": "https://cdn.dummyjson.com/product-images/beauty/essence-mascara-lash-princess/thumbnail.webp"
          }
        }
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "example": 0
          },
          "skip": {
            "type": "integer",
            "example": 0
          },
          "limit": {
            "type": "integer",
            "example": 30
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from /auth/login"
      }
    }
  }
}
